<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>kq-dir</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.konslie.mqdir</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>kq-dir needs access to your Desktop to browse files there.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>kq-dir needs access to your Documents to browse files there.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>kq-dir needs access to your Downloads to browse files there.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Based on mq-dir by h5nam. Copyright © 2026 mq-dir contributors. MIT License.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>kq-dir needs access to your network volumes to browse files there.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>kq-dir needs access to your removable volumes to browse files there.</string>
</dict>
</plist>
